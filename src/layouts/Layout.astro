---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Chatbot from '../components/Chatbot.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PartsCloud — KI-gestützte Ersatzteilplanung',
  description = 'PartsCloud verbindet sich nativ mit Ihrem ERP und liefert KI-basierte Bestellvorschläge. Weniger Fehlteile, weniger Überbestand, mehr Service-Umsatz.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>

  <!-- Preconnect for Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
</head>
<body>
  <!-- Ambient background -->
  <div class="bg-orb bg-orb-1" aria-hidden="true"></div>
  <div class="bg-orb bg-orb-2" aria-hidden="true"></div>
  <div class="bg-orb bg-orb-3" aria-hidden="true"></div>
  <div class="noise" aria-hidden="true"></div>

  <Nav />

  <main>
    <slot />
  </main>

  <Footer />
  <Chatbot />

  <!-- Scroll reveal -->
  <script>
    const observer = new IntersectionObserver(
      entries => entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          observer.unobserve(e.target);
        }
      }),
      { threshold: 0.1 }
    );
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</body>
</html>
