---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Kontakt — PartsCloud"
  description="Kontaktieren Sie PartsCloud direkt — Benjamin Reichenecker und Fabian Gemmecke sprechen persönlich mit Ihnen über Ihre Herausforderungen in der Ersatzteilplanung."
>

  <div class="subhero">
    <div class="subhero-badge">Kontakt</div>
    <h1 class="subhero-h1">
      Sprechen wir.<br />
      <span class="grad">Ohne Umwege.</span>
    </h1>
    <p class="subhero-desc">
      Kein Sales-Funnel, kein automatisierter Prozess. Sie sprechen direkt mit den Gründern
      und bekommen ehrliche Antworten auf Ihre Fragen.
    </p>
  </div>

  <section class="s" style="padding: 0 0 var(--s10)">
    <div class="s-inner">
      <div class="contact-layout">

        <!-- Ansprechpartner -->
        <div class="contact-persons reveal">
          <div class="s-eyebrow" style="margin-bottom:var(--s3)">Ihre Ansprechpartner</div>
          <div class="person-card">
            <div class="person-av" aria-hidden="true">BR</div>
            <div>
              <div class="person-name">Benjamin Reichenecker</div>
              <div class="person-role">Co-Founder &amp; CEO</div>
              <a href="mailto:benjamin@partscloud.de" class="person-link">benjamin@partscloud.de</a>
            </div>
          </div>
          <div class="person-card">
            <div class="person-av" aria-hidden="true">FG</div>
            <div>
              <div class="person-name">Fabian Gemmecke</div>
              <div class="person-role">Co-Founder &amp; CTO</div>
              <a href="mailto:fabian@partscloud.de" class="person-link">fabian@partscloud.de</a>
            </div>
          </div>
          <div class="address-block">
            <div class="address-label">Adresse</div>
            <address>
              PartsCloud GmbH<br />
              Eichenstraße 20<br />
              72124 Pliezhausen
            </address>
            <a href="mailto:info@partscloud.de" class="address-email">info@partscloud.de</a>
          </div>
        </div>

        <!-- Formular -->
        <div class="reveal" data-delay="1">
          <div class="contact-form">
            <div class="s-eyebrow" style="margin-bottom:var(--s3)">Nachricht senden</div>
            <form action="mailto:info@partscloud.de" method="post" enctype="text/plain">
              <div class="form-group">
                <label class="form-label" for="name">Name</label>
                <input class="form-input" id="name" name="name" type="text" placeholder="Ihr Name" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="email">E-Mail</label>
                <input class="form-input" id="email" name="email" type="email" placeholder="ihre@firma.de" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="company">Unternehmen</label>
                <input class="form-input" id="company" name="company" type="text" placeholder="Firma GmbH" />
              </div>
              <div class="form-group">
                <label class="form-label" for="message">Nachricht</label>
                <textarea class="form-textarea" id="message" name="message" placeholder="Was beschäftigt Sie? Welche Herausforderungen haben Sie in der Ersatzteilplanung?" required></textarea>
              </div>
              <button type="submit" class="btn-primary" style="width:100%;justify-content:center;">
                Nachricht senden
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
.contact-layout {
  display: grid; grid-template-columns: 1fr 1fr; gap: var(--s7); align-items: start;
  max-width: 960px; margin: 0 auto;
}
.contact-persons { display: flex; flex-direction: column; gap: var(--s3); }

.person-card {
  display: flex; align-items: center; gap: var(--s3);
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 16px; padding: var(--s3);
  transition: border-color 0.25s, transform 0.3s var(--ease-out);
}
.person-card:hover { border-color: rgba(139, 92, 246, 0.25); transform: translateY(-3px); }
.person-av {
  width: 52px; height: 52px; border-radius: 50%; flex-shrink: 0;
  background: rgba(139, 92, 246, 0.15); border: 2px solid rgba(139, 92, 246, 0.3);
  display: flex; align-items: center; justify-content: center;
  font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 800; color: var(--purple-l);
}
.person-name { font-family: 'Syne', sans-serif; font-size: 15px; font-weight: 700; color: var(--text-1); margin-bottom: 2px; }
.person-role { font-size: 12.5px; color: var(--text-3); margin-bottom: 6px; }
.person-link {
  font-size: 13px; color: var(--purple-l); text-decoration: none;
  transition: color 0.2s;
}
.person-link:hover { color: #c4b5fd; }

.address-block {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 16px; padding: var(--s3);
}
.address-label {
  font-size: 10px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase;
  color: var(--text-3); margin-bottom: var(--s2);
}
.address-block address {
  font-style: normal; font-size: 13.5px; color: var(--text-2); line-height: 1.7; margin-bottom: var(--s2);
}
.address-email {
  font-size: 13px; color: var(--purple-l); text-decoration: none;
}
.address-email:hover { color: #c4b5fd; }
</style>
